#!/usr/bin/env bash
# MARKER: agent-task-crew-hook
# Reminder/acknowledgment only. No network calls or agent execution.
set -euo pipefail

BLOCKING="${AGENT_TASK_HOOK_BLOCKING:-__DEFAULT_BLOCKING__}"
SILENT="${AGENT_TASK_HOOK_SILENT:-false}"
root="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
has_crews=false

# Portable sync records use UUID filenames. Claude artifacts carry a fixed stamp.
for file in "$root"/.agent-task/crews/*.json "$root"/.claude/agents/*.md; do
  if [ ! -f "$file" ] || [ -L "$file" ]; then
    continue
  fi
  case "$file" in
    *.sync.json) continue ;;
    *.json)
      name="${file##*/}"
      if [[ "$name" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}\.json$ ]]; then
        has_crews=true
        break
      fi
      ;;
    *.md)
      if grep -Eq '^<!-- agent-task crew: [0-9a-fA-F-]{36}( |$)' "$file"; then
        has_crews=true
        break
      fi
      ;;
  esac
done
[ "$has_crews" = true ] || exit 0

log() {
  if [ "$SILENT" != true ]; then printf '%s\n' "$*" >&2; fi
  return 0
}
log "Agent Task: synced crews are present; check relevant crew reviews before pushing."
log "Use your harness's crew workflow (Claude Code: /agent-task:crews check)."

if [ "$BLOCKING" = true ] && [ "${AGENT_TASK_HOOK_ACK:-}" != 1 ]; then
  log "Push blocked by the optional crew acknowledgment gate."
  log "After checking the reviews, retry with AGENT_TASK_HOOK_ACK=1 git push."
  exit 1
fi
exit 0
